{
  "name": "sip-water-reminder",
  "productName": "Sip",
  "version": "1.0.0",
  "description": "A water reminder you can't fake — it opens your camera and only clears the alarm once it sees you actually drink.",
  "main": "main.js",
  "author": "Sip",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps || exit 0"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.sip.waterreminder",
    "productName": "Sip",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "mac": {
      "category": "public.app-category.healthcare-fitness",
      "icon": "assets/icon.png",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "extendInfo": {
        "NSCameraUsageDescription": "Sip uses the camera locally to verify you're actually drinking water. Video never leaves your device."
      }
    },
    "win": {
      "icon": "assets/icon.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "assets/icon.png",
      "category": "Utility",
      "target": ["AppImage"]
    }
  }
}
